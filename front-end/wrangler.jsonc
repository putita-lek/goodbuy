// Cloudflare Worker that serves the GoodBuy site and forwards /api/* to the Go API.
// Deploy from front-end/:  npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodbuy",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "goodbuy.sohamjadhav.com", "custom_domain": true }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // Set to the Render URL of the Go API (no trailing slash).
    "API_ORIGIN": "https://goodbuy-api.onrender.com"
  },
  "observability": { "enabled": true }
}
